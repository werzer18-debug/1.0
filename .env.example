# Copy this file to .env and fill in the values.

# Your bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your-bot-token-here

# Your application (client) ID, found on the same page
CLIENT_ID=your-application-id-here

# Optional: restrict slash-command deployment to a single guild during
# development (commands appear instantly instead of taking up to an hour).
# Leave blank to deploy commands globally.
GUILD_ID=

# Optional: path to the data file (default: data/tempvoice.json)
DATABASE_PATH=data/tempvoice.json
